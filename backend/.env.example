# MediMate AI - Personal Health Copilot Environment Configuration
PROJECT_NAME="MediMate AI – Personal Health Copilot"
VERSION="1.0.0"

# Optional External LLM Integration (Google Gemini API / OpenAI API)
# If empty, MediMate runs in high-fidelity Clinical Heuristic Demo Mode with safety badges
GEMINI_API_KEY=""
OPENAI_API_KEY=""
FORCE_DEMO_MODE=false

# SQLite Database Location
DATABASE_URL="sqlite:///./medimate.db"

# Limits & Storage
MAX_FILE_SIZE_MB=15

# Production CORS & Frontend Configuration
# Specify your deployed Vercel domain or comma-separated origins
FRONTEND_URL="https://your-medimate-frontend.vercel.app"
# CORS_ORIGINS="https://your-medimate-frontend.vercel.app,http://localhost:5173"
